# ============================================================
# OpenAI (Required — powers interview + blueprint generation)
# ============================================================
# Get your key at: https://platform.openai.com/api-keys
#
# Used for:
#   - gpt-4o-mini  → per-turn interview acknowledgments (cheap)
#   - gpt-4o       → final persona interpretation + blueprint arc design
#
# Without this key: the app falls back to keyword matching (fully functional,
#                   just less conversational and nuanced).
#
OPENAI_API_KEY=sk-...

# ============================================================
# Spotify (Optional — only needed to export to Spotify)
# ============================================================
# Create an app at: https://developer.spotify.com/dashboard
# Add http://localhost:8888/callback as a Redirect URI.
#
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback
